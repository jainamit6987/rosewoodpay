# Copy this file to .env and fill in values from your Supabase project's
# Settings -> API page. Never commit the real .env file.

# Server
PORT=4000

# Public project URL (same value used by the mobile client).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Anonymous/publishable key. Safe to expose to the mobile client; RLS
# policies are what actually restrict access, not this key.
SUPABASE_ANON_KEY=your-anon-key

# Service role key. SERVER-SIDE ONLY. This key bypasses Row Level Security.
# Never send it to the mobile app, never commit it, never log it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PaySharp UPI Intent API - all optional. Leave unset and the backend still
# boots fine; only POST /transactions/upi-intent and POST /webhooks/paysharp
# need these (see PAYSHARP_UPI_INTENT_INTEGRATION_PLAN.md). Sandbox and
# production each have their own base URL + token - generate the token from
# the PaySharp dashboard (Settings -> Configuration), never commit the real
# value. See paysharp_sandbox_credentials.txt (git-ignored) for this
# project's actual sandbox values.
PAYSHARP_BASE_URL=https://sandbox.paysharp.co.in/external/api/v1/upi
PAYSHARP_API_TOKEN=your-paysharp-api-token

# Our own secret, e.g. generate with `openssl rand -hex 32`. Appended as
# ?secret=... on the webhook URL registered in the PaySharp dashboard -
# PaySharp does not sign/HMAC its webhook payloads, so this is the only
# thing stopping a stranger from POSTing a fake "payment succeeded" event.
PAYSHARP_WEBHOOK_SECRET=your-own-random-secret
