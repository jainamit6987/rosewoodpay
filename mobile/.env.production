# Loaded automatically by Expo CLI during `npx expo export` (which always
# forces NODE_ENV=production, regardless of any NODE_ENV set externally -
# see https://docs.expo.dev/guides/environment-variables/). This is what
# the Dockerfile's mobile-build stage relies on for Cloud Run deploys -
# see the comment above `RUN npx expo export -p web` there for why the
# previous `--build-env-vars-file`/ARG approach never actually worked
# (that flag only applies to buildpacks builds, not Dockerfile builds,
# and this repo has a Dockerfile, so it was silently a no-op).
#
# Committed to git deliberately, unlike mobile/.env - both values here are
# the same non-secret ones from mobile/.env (the anon key is meant to be
# public; real security is Supabase RLS). Keep in sync with mobile/.env
# by hand if you ever rotate the Supabase project.
EXPO_PUBLIC_SUPABASE_URL=https://hzjnbunuinewbeaxzxhh.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ptZA8k379I9oQ5SOhmh7Qw_5ePIKCDJ

# Deliberately empty - see the matching comment in mobile/.env and
# mobile/src/api/client.js. The built app calls the API relative to
# whatever origin served it (this same backend, same-origin, in Cloud Run).
EXPO_PUBLIC_BACKEND_URL=
