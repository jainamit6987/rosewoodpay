# Copy this file to .env and fill in real values, same project as
# backend/.env. Never commit the real .env file - the root .gitignore
# already excludes it.
#
# Every variable here MUST be prefixed EXPO_PUBLIC_ to be readable from app
# code at all (Expo's build step only inlines that prefix) - so treat all of
# these as visible-to-the-end-user, same as the anon key already is
# everywhere else in this project. Never put the service-role key here.

# Same Supabase project as backend/.env.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Leave this EMPTY (or delete the line) for the normal PWA setup - the
# Express backend (backend/) also serves this app's own web build
# (mobile/dist, see PERSONAL_LAPTOP_SETUP_AND_TESTING.md Section 3), so
# frontend and API are same-origin and the app can just call relative
# paths like /health, /auth/login, etc. wherever the page happens to be
# hosted (localhost, your LAN IP, an ngrok URL, or a real production
# domain later) - no rebuild needed when that URL changes.
#
# Only set this to an absolute URL if you specifically want the web app
# and the API on two different hosts/ports (e.g. running `npx expo start
# --web` for quick local iteration against a backend on another port).
EXPO_PUBLIC_BACKEND_URL=
