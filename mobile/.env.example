# Copy this file to .env and fill in real values, same project as
# backend/.env. Never commit the real .env file - the root .gitignore
# already excludes it.
#
# Every variable here MUST be prefixed EXPO_PUBLIC_ to be readable from app
# code at all (Expo's build step only inlines that prefix) - so treat all of
# these as visible-to-the-end-user, same as the anon key already is
# everywhere else in this project. Never put the service-role key here.

# Same Supabase project as backend/.env.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The Express backend from backend/. Points at your machine's LAN IP (not
# localhost/127.0.0.1) when testing on a physical device via Expo Go, since
# the phone and the backend are different devices on the network - e.g.
# http://192.168.1.23:4000. localhost is only correct when testing in the
# web browser (npm run web) or an Android emulator with adb reverse set up.
EXPO_PUBLIC_BACKEND_URL=http://localhost:4000
