# Environment secrets - never commit real keys/passwords
.env
.env.local
*.env
!*.env.example

# PaySharp sandbox/production credentials (dashboard login, API token) -
# reference notes only, never committed.
paysharp_sandbox_credentials.txt
paysharp_production_credentials.txt

# Cloud Run build-time env vars file (see CLOUD_RUN_DEPLOYMENT.md) -
# holds real Supabase URL/anon key values, created locally, never
# committed.
cloudbuild-env.yaml

# Node
node_modules/
npm-debug.log*

# Supabase local CLI state (machine-specific link/session info)
supabase/.branches/
supabase/.temp/

# OS
.DS_Store
Thumbs.db

# Excel lock files
~$*.xlsx

# Personal workflow-tracking doc - a planning tool, not app code; kept
# locally, not versioned (frequent edits, and .xlsx diffs are unreadable).
app-workflows.csv
app-workflows.xlsx
